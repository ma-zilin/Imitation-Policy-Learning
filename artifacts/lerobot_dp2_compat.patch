+class _PyAVVideoReader:
+    """Provide the small VideoReader interface used below with current PyAV."""
+
+    def __init__(self, video_path: str):
+        self.container = av.open(video_path)
+        self.stream = self.container.streams.video[0]
+
+    def seek(self, timestamp: float, keyframes_only: bool = True) -> None:
+        self.container.seek(int(timestamp / self.stream.time_base), stream=self.stream, backward=True)
+
+    def __iter__(self):
+        for frame in self.container.decode(self.stream):
+            if frame.pts is None:
+                continue
+            yield {
+                "pts": float(frame.pts * self.stream.time_base),
+                "data": torch.from_numpy(frame.to_ndarray(format="rgb24")).permute(2, 0, 1),
+            }
